# Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFILE_ID=
STRIPE_MPP_SECRET_KEY=
TEMPO_DEPOSIT_ADDRESS=
PLATFORM_FEE_BPS=1000
NEXT_PUBLIC_APP_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated Clerk emails that can review reports and remove stalls
ADMIN_EMAILS=you@example.com

# Fine-grained PAT: Contents Read and write on okita-io/mybot-farm-catalog only
# Used at runtime (farm_update publish) and at build (scripts/pull-catalog.sh → public/packs)
CATALOG_GITHUB_TOKEN=
CATALOG_GITHUB_OWNER=okita-io
CATALOG_GITHUB_REPO=mybot-farm-catalog
CATALOG_GITHUB_BRANCH=main
# Optional: pin a commit SHA for reproducible builds (default: tip of branch)
CATALOG_GITHUB_SHA=
