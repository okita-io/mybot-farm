#!/usr/bin/env python3
"""CLI smoke-test wrapper for hermes-mybot-farm (no agent loop).

  python3 bin/farm-plant search workbench
  python3 bin/farm-plant get scholastic-research
  python3 bin/farm-plant plant scholastic-research --dry-run
  python3 bin/farm-plant reinstall workbench --force --clean
  python3 bin/farm-plant post --kind agent --name "Smoke Bot" --title "…" \
      --description "…" --category Experimental --price-cents 0 --pack pack.json --dry-run
  python3 bin/farm-plant clear-tombstones workbench-spec workbench-scaffold
"""

from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
_spec = importlib.util.spec_from_file_location(
    "hermes_mybot_farm_plugin_loader",
    ROOT / "plugin_loader.py",
)
assert _spec and _spec.loader
_loader = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_loader)
_loader.ensure_plugin_package()

from hermes_mybot_farm.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
