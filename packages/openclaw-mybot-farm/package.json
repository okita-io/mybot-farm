{
  "name": "@okita-io/openclaw-mybot-farm",
  "version": "0.2.0",
  "description": "OpenClaw native tools to search, plant, and post mybot.farm GAF agent packs",
  "type": "module",
  "license": "MIT",
  "author": "okita-io",
  "homepage": "https://mybot.farm/install/openclaw",
  "bugs": {
    "url": "https://github.com/okita-io/mybot-farm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okita-io/mybot-farm.git",
    "directory": "packages/openclaw-mybot-farm"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "INSTALL.md",
    "README.md",
    "assets",
    "bin",
    "dist",
    "index.ts",
    "mcp",
    "openclaw.plugin.json",
    "src"
  ],
  "bin": {
    "farm-plant": "./bin/farm-plant.mjs"
  },
  "scripts": {
    "plant": "node ./bin/farm-plant.mjs",
    "test": "node --test tests/*.test.mjs",
    "plugin:validate": "openclaw plugins validate --root .",
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:openclaw --external:openclaw/* --external:typebox",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "^1.0.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "keywords": [
    "openclaw",
    "mybot.farm",
    "gaf",
    "agent-pack",
    "clawhub"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js"
}
